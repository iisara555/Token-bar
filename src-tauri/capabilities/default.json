{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Permissions for the bar, popover and settings surfaces. Deliberately narrow: the webview gets no filesystem, shell or arbitrary-HTTP access. All network calls to provider APIs happen in Rust, so an XSS in the UI cannot reach a provider host or read a key.",
  "windows": ["bar", "popover", "settings"],
  "permissions": [
    "core:default",
    "core:window:allow-start-dragging",
    "core:window:allow-set-size",
    "core:window:allow-set-position",
    "core:window:allow-set-always-on-top",
    "core:window:allow-set-ignore-cursor-events",
    "core:window:allow-show",
    "core:window:allow-hide",
    "core:window:allow-close",
    "core:window:allow-minimize",
    "core:window:allow-set-focus",
    "core:window:allow-current-monitor",
    "core:window:allow-scale-factor",
    "core:window:allow-theme",
    "core:window:allow-inner-size",
    "core:window:allow-outer-position",
    "core:event:default",
    "core:app:allow-version",
    "notification:default",
    "global-shortcut:allow-register",
    "global-shortcut:allow-unregister",
    "autostart:allow-enable",
    "autostart:allow-disable",
    "autostart:allow-is-enabled"
  ]
}
